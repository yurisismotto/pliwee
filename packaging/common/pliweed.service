[Unit]
Description=Pliwee — local device continuity daemon
Documentation=https://github.com/yurisismotto/pliwee
# Wait for a usable network, but do not fail without one: the daemon retries
# and mDNS comes and goes with the link.
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/pliweed
Restart=on-failure
RestartSec=5

# The daemon never needs privileges. It binds a port above 1024, writes only
# under $XDG_DATA_HOME, and talks to a socket in $XDG_RUNTIME_DIR.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

# --- the runtime directory -------------------------------------------------
# $XDG_RUNTIME_DIR/pliwee holds control.sock. systemd creates it, owns it,
# and removes it when the unit stops.
#
# It is systemd's job and not the daemon's because ProtectSystem=strict IS
# effective in a user unit on this systemd: a sandboxed daemon cannot mkdir in
# $XDG_RUNTIME_DIR, so without this the control socket has nowhere to live and
# the CLI, the GUI and the tray all have nothing to connect to. Measured:
# docs/audits/packaging/PACKAGING-V1-READINESS-AUDIT.md §4.2 probes B and D,
# re-measured against this file in PACKAGING-V1-SYSTEMD-UNIT.md gate S2.
#
# 0700 is the same mode the daemon applies to the directory itself when it is
# run outside systemd (platform-linux/src/lib.rs `bind`), so the two paths
# agree rather than one relaxing what the other tightened.
RuntimeDirectory=pliwee
RuntimeDirectoryMode=0700

# --- the data directory ----------------------------------------------------
# $XDG_DATA_HOME/pliwee holds identity.key and state.json — the trust
# store. It is the one path outside the runtime directory the daemon writes,
# and it is deliberately NOT package-owned: the package must never create,
# move or remove it.
#
# On the first start after an upgrade from OmniBridge the daemon also READS
# $XDG_DATA_HOME/omnibridge, to copy the identity across (ADR-0020 D9), and
# ~/.config/systemd/user, to notice an enablement still made under the old
# unit name. Both are reads; ProtectHome=read-only already permits them, and
# nothing below was widened for either.
#
# The grant is the parent, ~/.local/share, and not the leaf. Two measured
# reasons, both in PACKAGING-V1-SYSTEMD-UNIT.md gate S1:
#
#   * ReadWritePaths= without a '-' prefix refuses to start a unit whose path
#     does not exist, which is every fresh install; and
#   * the '-' prefix does not then punch the hole either, so the daemon's
#     first run cannot create its own data directory inside a read-only $HOME.
#
# Granting the parent — which exists for every desktop user — is one directory
# wider than ideal and stays entirely inside ProtectHome=read-only. It is a
# bounded, reviewable widening and NOT a weakening of ProtectSystem=strict,
# which is untouched above.
#
# StateDirectory= is NOT used. In a *user* unit it maps to $XDG_STATE_HOME
# (~/.local/state), which the daemon never opens: it would create an empty
# directory nobody reads and do nothing for the one that matters.
ReadWritePaths=%h/.local/share

# --- why ProtectKernelModules= is NOT here ---------------------------------
# It was here, and it made the unit unstartable on both Ubuntu targets.
#
# ProtectKernelModules=yes implies CapabilityBoundingSet=~CAP_SYS_MODULE. In a
# *user* unit the manager runs unprivileged, so systemd can only apply a
# bounding-set change from inside an unprivileged user namespace. Where that is
# permitted the unit starts; where it is not, systemd falls back to a direct
# PR_CAPBSET_DROP, which needs CAP_SETPCAP that no user process has, and the
# unit dies before ExecStart with status=218/CAPABILITIES:
#
#   (ibridged)[3727]: omnibridged.service: Failed to drop capabilities:
#                     Operation not permitted
#   omnibridged.service: Main process exited, code=exited,
#                        status=218/CAPABILITIES
#
# MEASURED on the shipped 0.1.0-1 packages, one drop-in per directive:
#
#   Fedora 44      systemd 259.9-1.fc44        starts
#   Debian 13      systemd 257.13-1~deb13u1    starts
#   Ubuntu 24.04   systemd 255.4-1ubuntu8.17   FAILS 218/CAPABILITIES
#   Ubuntu 26.04   systemd 259.5-0ubuntu3.4    FAILS 218/CAPABILITIES
#
# Turning off ProtectKernelTunables=, ProtectControlGroups= or
# RestrictNamespaces= individually did not help; turning off
# ProtectKernelModules= alone did. It is the only directive in this unit that
# reaches the capability path.
#
# Removing it costs nothing that is not already covered twice over, MEASURED:
#
#   * `systemd-analyze syscall-filter @system-service` does NOT list
#     init_module, finit_module or delete_module. SystemCallFilter= above is an
#     allow-list, so all three module syscalls are already blocked by it.
#   * an unprivileged process has CapEff=0000000000000000 — no CAP_SYS_MODULE
#     to use even if a syscall got through.
#   * NoNewPrivileges=true is set, so the bounding set cannot be re-gained
#     across an execve either.
#
# This is therefore a removal of a redundant directive that broke two of four
# supported distributions, not a relaxation of the sandbox. Nothing else in
# this file changed. packaging-checks.sh asserts it does not come back, and
# packaging/tests/lifecycle-gates.sh asserts the unit actually STARTS on each
# distribution — the gate whose absence let this ship.
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
# LAN only. No other address families are needed, and denying the rest turns a
# hypothetical bug into a failed syscall.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=default.target
# The OmniBridge 1.0.0 name, omnibridged.service, is NOT an Alias= here. An
# Alias= only takes effect when someone runs `enable`, and the accounts that
# need it enabled the old name long before this file existed. The packages
# instead ship omnibridged.service as a symlink to this file in the same
# directory, which systemd loads as an alias whether or not anything is
# re-enabled: see packaging/common/README.md, "Upgrading from OmniBridge".
