#!/usr/bin/env bash
# commit-msg — installed only in the issue worker's checkout
# (git config core.hooksPath .github/agent/hooks). Refuses a commit whose
# identity is not the owner's or whose message carries AI attribution.
# AGENTS.md § Git Authorship Policy.
set -uo pipefail
# The guard next to this hook, not the one in the working tree: the issue
# worker runs these hooks from a copy taken before it started, which an edit
# in the checkout cannot reach.
guard="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)/agent-guard.sh"
"$guard" identity >/dev/null && "$guard" message "$1"
