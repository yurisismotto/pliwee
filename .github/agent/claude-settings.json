{
  "$comment": "Permissions for the headless issue worker only (claude -p --settings .github/agent/claude-settings.json). Not loaded by interactive sessions. In -p mode a command matching no allow rule is refused, so the allow list is the boundary and the deny list documents intent. Neither is a security boundary on its own: prefix rules can be sidestepped, which is why the git hooks, the token's scopes and the post-run verification exist. Path rules use Edit(...), which covers every file-editing tool including Write. See docs/development/AGENT-WORKFLOW.md \u00a7 Security model.",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Glob",
      "Grep",
      "Bash(cd:*)",
      "Bash(pwd)",
      "Bash(ls:*)",
      "Bash(echo:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current:*)",
      "Bash(git add:*)",
      "Bash(git commit -m:*)",
      "Bash(git commit -F:*)",
      "Bash(git fetch origin:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(./.github/agent/agent-guard.sh:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo build:*)",
      "Bash(cargo metadata:*)",
      "Bash(./gradlew:*)",
      "Bash(./packaging/tests/packaging-checks.sh:*)",
      "Bash(./packaging/tests/harness-selftests.sh:*)",
      "Bash(./packaging/tests/release-signing-tests.sh:*)",
      "Bash(./packaging/tests/evidence-whitespace-check.sh:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr edit --add-reviewer:*)",
      "Bash(gh pr close:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh repo:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh label:*)",
      "Bash(gh ruleset:*)",
      "Bash(gh auth:*)",
      "Bash(gh api:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git commit --amend:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git config:*)",
      "Bash(git -c:*)",
      "Bash(git filter-branch:*)",
      "Bash(git tag:*)",
      "Bash(sudo:*)",
      "Bash(adb:*)",
      "Bash(virsh:*)",
      "Edit(.github/workflows/**)",
      "Edit(.github/agent/**)",
      "Edit(AGENTS.md)",
      "Edit(docs/audits/**)",
      "Edit(docs/certification/**)",
      "Edit(docs/reports/**)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)"
    ]
  }
}
